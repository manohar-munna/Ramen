# Copy to .env and fill in. .env is gitignored and must never be committed.

# Required for the optional "Enhance" pass. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Defaults to gemini-2.5-pro.
# Pro models are not in the free tier; a new key gets 429 on them.
# Run: python enhancer.py --list-models
# GEMINI_MODEL=gemini-3.1-pro-preview
