# Copy to .env and fill in. .env is gitignored and must never be committed.

# Required for the optional "Enhance" pass. Get one at https://aistudio.google.com/apikey
#
# Several, comma separated, if you have them: the free tier counts per key AND per
# model, so a run that has nothing left on one carries on with the next. Run
# `python tools/check_keys.py` to see which of them still work. It never prints a key.
GEMINI_API_KEYS=

# A single key works too; both names are read, and so is GOOGLE_API_KEY.
# GEMINI_API_KEY=

# Optional. Defaults to gemini-3-flash-preview, and falls back through the other
# flash models and then the lite ones, which hold a separate allowance.
#
# Not a pro model: those are outside the free tier, so a new key gets 429 on every
# one of them and works immediately on flash.
# Run `python enhancer.py --list-models` for what a key can actually call.
# GEMINI_MODEL=gemini-3.5-flash
